{
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/consulting",
      "destination": "/consulting.html"
    },
    {
      "source": "/consult-survey",
      "destination": "/consult-survey.html"
    },
    {
      "source": "/business",
      "destination": "/business.html"
    },
    {
      "source": "/global",
      "destination": "/global.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/academy",
      "destination": "/academy/index.html"
    },
    {
      "source": "/academy/instructor",
      "destination": "/academy/instructor/index.html"
    },
    {
      "source": "/academy/courses",
      "destination": "/academy/courses/index.html"
    },
    {
      "source": "/academy/classroom",
      "destination": "/academy/classroom/index.html"
    }
  ]
}
